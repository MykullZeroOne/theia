# Exclude node_modules (will be installed fresh)
**/node_modules

# Exclude git
.git
.gitignore
**/.git

# Exclude build artifacts (will be rebuilt)
**/lib
**/build
**/dist

# Exclude IDE files
.vscode
.idea
**/.vscode
**/.idea

# Exclude logs
*.log
**/*.log
npm-debug.log

# Exclude test files
**/*.spec.ts
**/*.spec.js
**/*.test.ts
**/*.test.js
**/test/
**/tests/
coverage
.nyc_output

# Exclude temporary files
.DS_Store
**/.DS_Store
.env.local
.env.*.local

# Exclude examples (large, not needed for backend)
examples/

# Keep important docs
!packages/core-mobile/API_DOCUMENTATION.md
!packages/core-mobile/DOCKER_DEPLOYMENT.md
