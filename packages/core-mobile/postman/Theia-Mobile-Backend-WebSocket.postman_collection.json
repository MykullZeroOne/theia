						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{$guid}}\",\n  \"method\": \"mobile/restoreSession\",\n  \"params\": [{\n    \"sessionId\": \"{{sessionId}}\",\n    \"clientId\": \"{{clientId}}\"\n  }]\n}",
