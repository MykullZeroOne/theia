  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate UUID for request ID if not set",
          "if (!pm.variables.get('requestId')) {",
          "    pm.variables.set('requestId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
