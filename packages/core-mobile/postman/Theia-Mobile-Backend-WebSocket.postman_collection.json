			"name": "Initialization",
			"item": [
				{
					"name": "Initialize Session",
					"id": "1bd555c0-9112-4ba6-8352-9dd5b2ebf989",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{$guid}}\",\n  \"method\": \"mobile/initialize\",\n  \"params\": [{\n    \"clientInfo\": {\n      \"name\": \"ModusFabrica\",\n      \"version\": \"1.0.0\"\n    },\n    \"capabilities\": {}\n  }]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "ws://{{host}}:{{port}}/mobile",
							"protocol": "ws",
							"host": [
								"{{host}}"
							],
							"port": "{{port}}",
							"path": [
								"mobile"
							]
						},
						"description": "Initialize the mobile session and exchange capabilities between client and server.\n\n**Request**:\n- `clientInfo.name`: Client application name\n- `clientInfo.version`: Client version\n- `capabilities`: Client capabilities (currently empty object)\n\n**Response**:\n- `serverCapabilities`: LSP capabilities (textDocumentSync, completionProvider, etc.)\n- `mobileCapabilities`: Mobile-specific capabilities (offlineMode, backgroundSync, etc.)"
					},
					"response": [
						{
							"id": "809f3c4f-ea27-4b75-8c51-137c6b792eae",
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"id\": \"1\",\n  \"method\": \"mobile/initialize\",\n  \"params\": [{\n    \"clientInfo\": {\n      \"name\": \"ModusFabrica\",\n      \"version\": \"1.0.0\"\n    },\n    \"capabilities\": {}\n  }]\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "ws://localhost:3030/mobile",
									"protocol": "ws",
									"host": [
										"localhost"
									],
									"port": "3030",
									"path": [
										"mobile"
									]
								}
							},
							"_postman_previewlanguage": "json",
							"_postman_previewtype": "html",
							"header": [],
							"cookie": [],
							"body": "{\n  \"id\": \"1\",\n  \"result\": {\n    \"serverCapabilities\": {\n      \"textDocumentSync\": 2,\n      \"completionProvider\": {\n        \"triggerCharacters\": [\".\", \":\"]\n      },\n      \"hoverProvider\": true,\n      \"definitionProvider\": true\n    },\n    \"mobileCapabilities\": {\n      \"offlineMode\": true,\n      \"backgroundSync\": true,\n      \"gestureSupport\": true,\n      \"hapticFeedback\": true\n    }\n  }\n}"
